--- VCU10/EPS_SCS_Monitor/EPS_SCS_Monitor ---
function eps_safety_fault = eps_scs_monitor(msg1, msg2)
%#codegen
% 0x401: Byte7 = XOR(Byte0..Byte6); 0x402: Byte1 为发送计数。
persistent last_counter seen_count stale_count bad_count good_count fault
if isempty(last_counter)
    last_counter=msg2(2); seen_count=uint16(0); stale_count=uint16(0);
    bad_count=uint16(0); good_count=uint16(0); fault=true;
end
counter=msg2(2);
if counter~=last_counter
    last_counter=counter; stale_count=uint16(0);
    if seen_count<uint16(1000), seen_count=seen_count+uint16(1); end
else
    if stale_count<uint16(1000), stale_count=stale_count+uint16(1); end
end
checksum=uint8(0);
for k=1:7
    checksum=bitxor(checksum,msg1(k));
end
content_valid=(checksum==msg1(8)) && (msg1(3)==uint8(0)) && (msg1(7)==uint8(0));
fresh=(seen_count>=uint16(3)) && (stale_count<uint16(30));
valid_now=content_valid && fresh;
if valid_now
    bad_count=uint16(0); if good_count<uint16(1000), good_count=good_count+uint16(1); end
    if good_count>=uint16(50), fault=false; end
else
    good_count=uint16(0); if bad_count<uint16(1000), bad_count=bad_count+uint16(1); end
    if (bad_count>=uint16(3)) || (stale_count>=uint16(30)), fault=true; end
end
eps_safety_fault=fault;
end


--- VCU10/ASB_Selfcheck/FSEC_Sensor_Monitor/FSEC_Sensor_Monitor ---
function [brake_sensor_valid, safety_fault, brake_sensor_fault, air_sensor_fault, ebs_fault_indicator] = fsec_sensor_monitor(brake_raw_mv, air_ready_raw_mv, air_work_raw_mv, air_ready_bar, air_work_bar, esp_ok, res_ok, ebs_driver_ok)
%#codegen
% 制动踏板为 0-5 V；两路气压为 0-10 V。阈值需在最终标定后复核。
persistent brake_bad brake_good air_bad air_good comm_bad comm_good ebs_bad ebs_good brake_fault air_fault comm_fault ebs_comm_fault
if isempty(brake_bad)
    brake_bad=uint16(0); brake_good=uint16(0); air_bad=uint16(0); air_good=uint16(0);
    comm_bad=uint16(0); comm_good=uint16(0); ebs_bad=uint16(0); ebs_good=uint16(0);
    brake_fault=false; air_fault=false; comm_fault=false; ebs_comm_fault=false;
end
brake_now = (brake_raw_mv < 100.0) || (brake_raw_mv > 4900.0);
if brake_now
    brake_good=uint16(0); if brake_bad<uint16(1000), brake_bad=brake_bad+uint16(1); end
    if brake_bad>=uint16(10), brake_fault=true; end
else
    brake_bad=uint16(0); if brake_good<uint16(1000), brake_good=brake_good+uint16(1); end
    if brake_good>=uint16(50), brake_fault=false; end
end
% 储气侧低压可直接阻止 Ready；下游低压仅在 EBS 触发后由响应监控判断。
air_now = (air_ready_raw_mv > 9800.0) || (air_work_raw_mv > 9800.0) || ...
          (air_ready_bar < 2.5) || (air_work_bar > air_ready_bar + 1.5);
if air_now
    air_good=uint16(0); if air_bad<uint16(1000), air_bad=air_bad+uint16(1); end
    if air_bad>=uint16(50), air_fault=true; end
else
    air_bad=uint16(0); if air_good<uint16(1000), air_good=air_good+uint16(1); end
    if air_good>=uint16(50), air_fault=false; end
end
comm_now = (~logical(esp_ok)) || (~logical(res_ok)) || (~logical(ebs_driver_ok));
if comm_now
    comm_good=uint16(0); if comm_bad<uint16(1000), comm_bad=comm_bad+uint16(1); end
    if comm_bad>=uint16(30), comm_fault=true; end
else
    comm_bad=uint16(0); if comm_good<uint16(1000), comm_good=comm_good+uint16(1); end
    if comm_good>=uint16(50), comm_fault=false; end
end
% EBS 红灯只显示 EBS/制动冗余本体故障，不显示 RES 一般安全事件。
ebs_comm_now = (~logical(esp_ok)) || (~logical(ebs_driver_ok));
if ebs_comm_now
    ebs_good=uint16(0); if ebs_bad<uint16(1000), ebs_bad=ebs_bad+uint16(1); end
    if ebs_bad>=uint16(30), ebs_comm_fault=true; end
else
    ebs_bad=uint16(0); if ebs_good<uint16(1000), ebs_good=ebs_good+uint16(1); end
    if ebs_good>=uint16(50), ebs_comm_fault=false; end
end
brake_sensor_valid = (~brake_fault) && (~brake_now);
brake_sensor_fault = brake_fault;
air_sensor_fault = air_fault;
safety_fault = brake_fault || air_fault || comm_fault;
ebs_fault_indicator = brake_fault || air_fault || ebs_comm_fault;
end


--- VCU10/EBS/EBS_Response_Monitor/EBS_Response_Monitor ---
function ebs_sensor_fault = ebs_response_monitor(trigger, asms, driver_ok, air_ready_bar, air_work_bar)
%#codegen
% EBS_Driver 负责电气诊断；VCU 校验触发后的气动建压响应。
persistent last_trigger waiting wait_count relation_count clear_count fault_latched
if isempty(last_trigger)
    last_trigger=false; waiting=false; wait_count=uint16(0); relation_count=uint16(0);
    clear_count=uint16(0); fault_latched=false;
end
rising = logical(trigger) && ~last_trigger; last_trigger=logical(trigger);
if rising && logical(driver_ok) && (air_ready_bar >= 2.5) && (air_work_bar < 1.0)
    waiting=true; wait_count=uint16(0);
end
if waiting
    if air_work_bar >= 1.0
        waiting=false; wait_count=uint16(0);
    else
        if wait_count<uint16(1000), wait_count=wait_count+uint16(1); end
        if wait_count>=uint16(20), fault_latched=true; waiting=false; end
    end
end
if air_work_bar > air_ready_bar + 1.5
    if relation_count<uint16(1000), relation_count=relation_count+uint16(1); end
    if relation_count>=uint16(20), fault_latched=true; end
else
    relation_count=uint16(0);
end
if (~logical(asms)) && logical(driver_ok) && (air_work_bar < 1.0) && (air_ready_bar >= 2.5)
    if clear_count<uint16(1000), clear_count=clear_count+uint16(1); end
    if clear_count>=uint16(100), fault_latched=false; end
else
    clear_count=uint16(0);
end
ebs_sensor_fault = fault_latched;
end


--- VCU10/Motor_Control/ManualTorque_Calculation/APPS_Electrical_Monitor/APPS_Electrical_Monitor ---
function [apps_valid, apps_electrical_fault] = apps_electrical_monitor(apps1_raw_mv, apps2_raw_mv)
%#codegen
% 0-5 V APPS 单通道开路/短路诊断；最终阈值由实车标定确认。
persistent bad_count good_count fault
if isempty(bad_count)
    bad_count=uint16(0); good_count=uint16(0); fault=false;
end
bad_now=(apps1_raw_mv<100.0)||(apps1_raw_mv>4900.0)||...
        (apps2_raw_mv<100.0)||(apps2_raw_mv>4900.0);
if bad_now
    good_count=uint16(0); if bad_count<uint16(1000), bad_count=bad_count+uint16(1); end
    if bad_count>=uint16(10), fault=true; end
else
    bad_count=uint16(0); if good_count<uint16(1000), good_count=good_count+uint16(1); end
    if good_count>=uint16(50), fault=false; end
end
apps_valid=(~bad_now) && (~fault);
apps_electrical_fault=fault;
end


