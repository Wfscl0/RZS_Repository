device S32K148
si SWD
speed 4000
connect
r
h
sleep 200
w4 0xE000ED08 0x00020000
wreg MSP, 0x2001EFF0
wreg PSP, 0x00000000
wreg CONTROL, 0x00000000
wreg XPSR, 0x01000000
setpc 0x00020410
g
sleep 1500
h
regs
mem32 0xE000ED08 1
mem32 0xE000ED28 1
g
// Retain the debug session so Commander cannot halt the application on exit.
sleep 60000
q
