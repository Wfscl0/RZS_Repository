      Path         ""\
      SrcLocation  "VCU10:1538:300-310"\
      Dimensions   [4]\
    }\
    ChartData {\
      Name         "ages"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "VCU10:1538:311-315"\
      Dimensions   [4]\
    }\
  }
  %return ChartDataElements
%endfunction
