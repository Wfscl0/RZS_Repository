        <P Name="isEML">1</P>
        <P Name="script">function [hin_sel, ain_sel, wheel_f_sel, wheel_h_sel, status_base, pedal_echo, air_wheel_echo] = dbg_select(hin_hw, ain_hw, wheel_f_hw, wheel_h_hw, control, pedal_adc, air_wheel, digital, rx_count)
%#codegen
% Bench-only CAN override. Any stale control/data frame restores hardware input.
persistent last_count ages initialized
if isempty(initialized)
    last_count = uint8(zeros(4,1));
    ages = repmat(uint8(50),4,1);
    initialized = true;
end
for i = 1:4
    if rx_count(i) ~= last_count(i)
        last_count(i) = rx_count(i);
        ages(i) = uint8(0);
    elseif ages(i) &lt; uint8(50)
        ages(i) = ages(i) + uint8(1);
    end
end
requested = uint8(0);
if control(1) == uint8(165) &amp;&amp; control(2) == uint8(90) &amp;&amp; ages(1) &lt; uint8(50)
    requested = bitand(control(3), uint8(15));
end
active = uint8(0);
if bitand(requested,uint8(1)) ~= uint8(0)
    active = bitor(active,uint8(1));
    if bitand(requested,uint8(2)) ~= uint8(0) &amp;&amp; ages(2) &lt; uint8(50)
        active = bitor(active,uint8(2));
    end
    if bitand(requested,uint8(4)) ~= uint8(0) &amp;&amp; ages(3) &lt; uint8(50)
        active = bitor(active,uint8(4));
    end
    if bitand(requested,uint8(8)) ~= uint8(0) &amp;&amp; ages(4) &lt; uint8(50)
        active = bitor(active,uint8(8));
    end
end
hin_sel = uint16(hin_hw);
ain_sel = uint16(ain_hw);
wheel_f_sel = single(wheel_f_hw);
wheel_h_sel = single(wheel_h_hw);
if bitand(active,uint8(8)) ~= uint8(0)
    hin_sel = uint16(digital(1)) + bitshift(uint16(digital(2)),8);
end
if bitand(active,uint8(2)) ~= uint8(0)
    ain_sel(1) = uint16(pedal_adc(1)) + bitshift(uint16(pedal_adc(2)),8);
    ain_sel(2) = uint16(pedal_adc(3)) + bitshift(uint16(pedal_adc(4)),8);
    ain_sel(3) = uint16(pedal_adc(5)) + bitshift(uint16(pedal_adc(6)),8);
end
if bitand(active,uint8(4)) ~= uint8(0)
    ain_sel(4) = uint16(air_wheel(1)) + bitshift(uint16(air_wheel(2)),8);
    ain_sel(5) = uint16(air_wheel(3)) + bitshift(uint16(air_wheel(4)),8);
    wheel_f_sel = single(uint16(air_wheel(5)) + bitshift(uint16(air_wheel(6)),8)) * single(0.1);
    wheel_h_sel = single(uint16(air_wheel(7)) + bitshift(uint16(air_wheel(8)),8)) * single(0.1);
end
status_base = uint8(zeros(8,1));
status_base(1) = active;
status_base(2) = requested;
status_base(3) = uint8(bitand(hin_sel,uint16(255)));
status_base(4) = uint8(bitshift(hin_sel,-8));
status_base(7) = ages(1);
status_base(8) = rx_count(1);
pedal_echo = uint8(zeros(8,1));
pedal_echo(1) = uint8(bitand(ain_sel(1),uint16(255)));
pedal_echo(2) = uint8(bitshift(ain_sel(1),-8));
pedal_echo(3) = uint8(bitand(ain_sel(2),uint16(255)));
pedal_echo(4) = uint8(bitshift(ain_sel(2),-8));
pedal_echo(5) = uint8(bitand(ain_sel(3),uint16(255)));
pedal_echo(6) = uint8(bitshift(ain_sel(3),-8));
if bitand(active,uint8(2)) ~= uint8(0)
    pedal_echo(7) = uint8(1);
end
pedal_echo(8) = rx_count(2);
air_wheel_echo = uint8(zeros(8,1));
air_wheel_echo(1) = uint8(bitand(ain_sel(4),uint16(255)));
air_wheel_echo(2) = uint8(bitshift(ain_sel(4),-8));
air_wheel_echo(3) = uint8(bitand(ain_sel(5),uint16(255)));
air_wheel_echo(4) = uint8(bitshift(ain_sel(5),-8));
wheel_raw = wheel_f_sel * single(10.0);
if wheel_raw &lt;= single(0.0)
    wheel_u16 = uint16(0);
elseif wheel_raw &gt;= single(65535.0)
    wheel_u16 = uint16(65535);
else
    wheel_u16 = uint16(floor(wheel_raw + single(0.5)));
end
air_wheel_echo(5) = uint8(bitand(wheel_u16,uint16(255)));
air_wheel_echo(6) = uint8(bitshift(wheel_u16,-8));
wheel_raw = wheel_h_sel * single(10.0);
if wheel_raw &lt;= single(0.0)
    wheel_u16 = uint16(0);
elseif wheel_raw &gt;= single(65535.0)
    wheel_u16 = uint16(65535);
else
    wheel_u16 = uint16(floor(wheel_raw + single(0.5)));
end
air_wheel_echo(7) = uint8(bitand(wheel_u16,uint16(255)));
air_wheel_echo(8) = uint8(bitshift(wheel_u16,-8));
end</P>
