[STATEFLOW]

CHART=VCU10/AS_Stateflow/Chart
 STATE AS_Driving | AS_Driving 
 STATE AS_Ready | AS_Ready ts_flag=1; r2d_flag=0; steering_flag=1; brake_flag=2; ebs_system_flag=1; as_led_yellow=1; as_led_blue=0; as_off_flag=0; as_ready_flag=1; as_driving_flag=0; as_finished_flag=0; as_emergency_flag=0; manual_driving_flag=0; as_ebs_trig=0;
 STATE transition | transition
 STATE AS_Off | AS_Off ts_flag=0; r2d_flag=0; steering_flag=0; brake_flag=0; ebs_system_flag=0; as_led_yellow=0; as_led_blue=0; as_off_flag=1; as_ready_flag=0; as_driving_flag=0; as_finished_flag=0; as_emergency_flag=0; manual_driving_flag=0; as_ebs_trig=0;
 STATE AS_Emergency | AS_Emergency ts_flag=0; r2d_flag=0; steering_flag=1; brake_flag=1; ebs_system_flag=2; as_ebs_trig=1; as_led_yellow=0; as_led_blue=2; as_off_flag=0; as_ready_flag=0; as_driving_flag=0; as_finished_flag=0; as_emergency_flag=1; manual_driving_flag=0; safety_lock=1;
 STATE AS_Finished | AS_Finished ts_flag=0; r2d_flag=0; steering_flag=0; brake_flag=0; ebs_system_flag=2; as_ebs_trig=1; as_led_yellow=0; as_led_blue=1; as_off_flag=0; as_ready_flag=0; as_driving_flag=0; as_finished_flag=1; as_emergency_flag=0; manual_driving_flag=0; safety_lock=1;
 STATE Manual_Driving | Manual_Driving ts_flag=0; r2d_flag=0; steering_flag=0; brake_flag=0; ebs_system_flag=0; as_led_yellow=0; as_led_blue=0; as_off_flag=0; as_ready_flag=0; as_driving_flag=0; as_finished_flag=0; as_emergency_flag=0; manual_driving_flag=1; as_ebs_trig=0;
 STATE R2D | R2D en: r2d_flag=1; as_ready_flag=0; as_driving_flag=1;
 STATE go | go ts_flag=1; r2d_flag=0; steering_flag=1; brake_flag=1; ebs_system_flag=1; as_led_yellow=2; as_led_blue=0; as_off_flag=0; as_ready_flag=0; as_driving_flag=1; as_finished_flag=0; as_emergency_flag=0; manual_driving_flag=0;
 TRANS AS_Driving -> AS_Finished | [car_spdzero==1&&task_finish==1&&safety_fault==0&&asms_button==1&&res_stop==0]{as_ebs_trig=1}
 TRANS AS_Ready -> <junction> | after(5,sec)
 TRANS <junction> -> AS_Driving | [res_go==1&&safety_fault==0&&asms_button==1&&res_stop==0]{r2d_warning=T;steer_return=T}
 TRANS <junction> -> AS_Emergency | [ebs_working==1||safety_fault==1||asms_button==0||res_stop==1]
 TRANS <junction> -> AS_Ready | [asb_check==1&&safety_fault==0&&safety_lock==0]
 TRANS AS_Driving -> <junction> | [ami_inspection==1]
 TRANS AS_Ready -> AS_Emergency | [ebs_working==1||safety_fault==1||asms_button==0||res_stop==1]
 TRANS AS_Driving -> AS_Emergency | [ebs_working==1||safety_fault==1||asms_button==0||res_stop==1]
 TRANS <junction> -> AS_Emergency | [ebs_working==1||safety_fault==1||asms_button==0||res_stop==1]
 TRANS transition -> <junction> | [ts==1]
 TRANS <junction> -> AS_Emergency | [ebs_working==1||safety_fault==1||asms_button==0||res_stop==1]
 TRANS <junction> -> AS_Finished | after(27,sec)[safety_fault==0&&asms_button==1&&res_stop==0]{as_ebs_trig=1}
 TRANS transition -> AS_Emergency | [ebs_working==1||safety_fault==1||asms_button==0||res_stop==1]
 TRANS AS_Off -> transition | [as_task==1&&asms_button==1&&safety_fault==0&&safety_lock==0]{brake_flag=2}
 TRANS <junction> -> AS_Off | [asms_button==0&&brake_on==0]
 TRANS AS_Emergency -> <junction> | [ebs_warning==0]
 TRANS AS_Finished -> AS_Emergency | [res_stop==1]
 TRANS AS_Off -> <junction> | [ami_manualdriving==1&&safety_fault==0&&safety_lock==0]
 TRANS AS_Finished -> AS_Off | [asms_button==0&&brake_on==0]
 TRANS Manual_Driving -> AS_Off | [ts==0]
 TRANS <junction> -> <junction> | [ebs_check==0]
 TRANS <junction> -> Manual_Driving | [ts==1]
 TRANS R2D -> go | [steer_zero==1] {steer_return=F;r2d_warning=F}

CHART=VCU10/Buzzer/Chart
 STATE Default | Default en: ebs_buzzer=F; 
 STATE Emergency | Emergency en: ebs_buzzer=T;
 TRANS Default -> Emergency | [as_emergency_flag==1]
 TRANS Emergency -> Default | [after(9,sec)]

CHART=VCU10/LED_Control/TSLED_Inspection
 STATE Inspection | Inspection en: led_imderr=T; led_bmserr=T;
 STATE Normal | Normal en: led_imderr=F; led_bmserr=F;
 TRANS Inspection -> Normal | [after(2,sec)]

CHART=VCU10/Motor_Control/Motor_Torque_Stateflow
 STATE Default | Default en: motor_torque=0; du: motor_torque=0;
 STATE AS_Driving | AS_Driving en: motor_torque=as_torque; du: motor_torque=as_torque;
 STATE Manual_Driving | Manual_Driving en: motor_torque=manual_torque; du: motor_torque=manual_torque;
 TRANS Default -> AS_Driving | [as_task==1]
 TRANS AS_Driving -> Default | [as_task==0]
 TRANS Default -> Manual_Driving | [manual_driving_flag==1]
 TRANS Manual_Driving -> Default | [manual_driving_flag==0]

CHART=VCU10/TS_Activation/Chart
 STATE Ignition_Check | Ignition_Check
 STATE Flameout_Check | Flameout_Check
 STATE begin | begin di8_flag=F;
 STATE DI8_Check_Flag | DI8_Check_Flag
 STATE Check | Check
 STATE DI8_Offcheck_Flag | DI8_Offcheck_Flag
 STATE Checkoff | Checkoff
 TRANS Ignition_Check -> Flameout_Check | [di8_flag==T]
 TRANS Flameout_Check -> Ignition_Check | [di8_flag==F]
 TRANS <junction> -> DI8_Check_Flag | [di8_check_flag==0]
 TRANS <junction> -> Check | [di8_check_flag==1]
 TRANS <junction> -> DI8_Offcheck_Flag | [di8_offcheck_flag==0]
 TRANS <junction> -> Checkoff | [di8_offcheck_flag==1]
 TRANS <junction> -> <junction> | [di8_button==0]
 TRANS <junction> -> <junction> | {di8_check_flag=0;}
 TRANS <junction> -> <junction> | {di8_check_flag=1;}
 TRANS <junction> -> <junction> | [di8_button==1]
 TRANS <junction> -> <junction> | {di8_flag=T;di8=T;}
 TRANS <junction> -> <junction> | [di8_button==0]
 TRANS <junction> -> <junction> | {di8_offcheck_flag=1;}
 TRANS <junction> -> <junction> | {di8_offcheck_flag}
 TRANS <junction> -> <junction> | [di8_button==1]
 TRANS <junction> -> <junction> | {di8_flag=F;di8=F;}

CHART=VCU10/TS_Activation/Chart1
 STATE Ignition_Check | Ignition_Check
 STATE Flameout_Check | Flameout_Check
 STATE begin | begin run_flag=0;
 STATE Run_Check_Flag | Run_Check_Flag
 STATE Check | Check
 STATE Run_Offcheck_Flag | Run_Offcheck_Flag
 STATE Checkoff | Checkoff
 TRANS Ignition_Check -> Flameout_Check | [run_flag==1]
 TRANS Flameout_Check -> Ignition_Check | [run_flag==0]
 TRANS <junction> -> Run_Check_Flag | [run_check_flag==0]
 TRANS <junction> -> Check | [run_check_flag==1]
 TRANS <junction> -> Run_Offcheck_Flag | [run_offcheck_flag==0]
 TRANS <junction> -> Checkoff | [run_offcheck_flag==1]
 TRANS <junction> -> <junction> | [run_button==0]
 TRANS <junction> -> <junction> | {run_check_flag=0;}
 TRANS <junction> -> <junction> | {run_check_flag=1;}
 TRANS <junction> -> <junction> | [run_button==1]
 TRANS <junction> -> <junction> | {run_flag=1;run=T;}
 TRANS <junction> -> <junction> | [run_button==0]
 TRANS <junction> -> <junction> | {run_offcheck_flag=1;}
 TRANS <junction> -> <junction> | {run_offcheck_flag}
 TRANS <junction> -> <junction> | [run_button==1]
 TRANS <junction> -> <junction> | {run_flag=0;run=F;}

CHART=VCU10/TS_Activation/Chart2
 STATE begin | begin
 STATE delay | delay
 TRANS begin -> <junction> | {ts=0}
 TRANS <junction> -> <junction> | [tsms_button==1]
 TRANS <junction> -> <junction> | [di8==1]
 TRANS <junction> -> <junction> | [as_flag==1]
 TRANS <junction> -> <junction> | [as_flag==0]
 TRANS <junction> -> delay | [run==1&&brake_on==1]{ts=1;ts_warning=T}
 TRANS <junction> -> delay | {ts=1}
 TRANS delay -> <junction> | after(2,sec)
 TRANS <junction> -> <junction> | {ts_warning=F}
 TRANS <junction> -> <junction> | [tsms_button==0||di8==0||run==0]{ts=0}

CHART=VCU10/AMI_CAN/AMI_Transmitmsg/Chart
 STATE as_off | as_off en: ami_process=0x01 
 STATE as_emergency | as_emergency en: ami_process=0x40
 STATE begin | begin 
 STATE munual_driving | munual_driving en: ami_process=0x02
 STATE as_finished | as_finished en: ami_process=0x20
 STATE as_ready | as_ready en: ami_process=0x04
 STATE as_driving | as_driving en: ami_process=0x10
 STATE r2d | r2d en: ami_process=0x08
 TRANS begin -> as_off | [as_off_flag==1]
 TRANS begin -> as_emergency | [as_emergency_flag==1]
 TRANS as_emergency -> begin | [as_emergency_flag~=1]
 TRANS as_off -> begin | [as_off_flag~=1]
 TRANS begin -> munual_driving | [munual_driving_flag==1]
 TRANS begin -> as_finished | [as_finished_flag==1]
 TRANS munual_driving -> begin | [munual_driving_flag~=1]
 TRANS as_finished -> begin | [as_finished_flag~=1]
 TRANS begin -> as_ready | [as_ready_flag==1]
 TRANS as_ready -> begin | [as_ready_flag~=1]
 TRANS begin -> r2d | [r2d_flag==1]
 TRANS r2d -> begin | [r2d_flag~=1]
 TRANS begin -> as_driving | [as_driving_flag==1]
 TRANS as_driving -> begin | [as_driving_flag~=1]

CHART=VCU10/EPS/EPS_TransmitMsg/EPS_Stateflow1
 STATE EPS_Unable | EPS_Unable en: eps_cmdworkmode=0x00; eps_cmdmiddle=0x00; 
 STATE EPS_Enable | EPS_Enable en: eps_cmdworkmode=0x10; eps_cmdangle=ipc_cmdangle; eps_cmdmiddle=0x00; eps_cmdvelocity=ipc_eps_velocity; du: eps_cmdworkmode=0x10; eps_cmdangle=ipc_cmdangle; eps_cmdmiddle=0x00; eps_cmdvelocity=ipc_eps_velocity;
 STATE EPS_Return | EPS_Return eps_cmdworkmode=0x10; eps_cmdangle=uint32(0x04); eps_cmdmiddle=0x55; eps_cmdvelocity=0x14;
 TRANS EPS_Enable -> EPS_Unable | [steering_flag==0]
 TRANS EPS_Unable -> EPS_Enable | [steering_flag==1]
 TRANS EPS_Enable -> <junction> | [after(10,msec)]
 TRANS <junction> -> EPS_Return | [steer_return==1]
 TRANS EPS_Return -> EPS_Enable | [steer_zero==1]

CHART=VCU10/LED_Control/EBS_LED/Shutdown_Button
 STATE begin | begin 
 STATE same1 | same1 shutdown_flag=T;
 STATE compare | compare shutdown_count = shutdown_count + 1;
 STATE judge | judge shutdown_flag=F;
 TRANS begin -> <junction> | after(1,sec)
 TRANS <junction> -> same1 | [Shutdown_Start==Shutdown_End]
 TRANS judge -> same1 | [Shutdown_Start==Shutdown_End]
 TRANS compare -> same1 | [Shutdown_Start==Shutdown_End]{shutdown_count=0}
 TRANS same1 -> compare | [Shutdown_Start~=Shutdown_End]
 TRANS compare -> judge | [shutdown_count>10]

CHART=VCU10/LED_Control/EBS_LED/display
 STATE begin | begin spark=T;
 STATE end | end spark=F;
 TRANS begin -> end | after(2,sec)

CHART=VCU10/LED_Control/Subsystem/blue
 STATE Delay | Delay en: blue=uint16(60000);
 STATE Node | Node en: blue=uint16(0);
 STATE Close | Close en: blue=uint16(0);
 STATE On | On en: blue=uint16(60000);
 STATE Blink | Blink en: blue=uint16(30000);
 TRANS Delay -> Node | after(2,sec)
 TRANS Node -> Close | [as_led_blue==0]
 TRANS Node -> Blink | [as_led_blue==2]
 TRANS Node -> On | [as_led_blue==1]
 TRANS Close -> On | [as_led_blue==1]
 TRANS On -> Blink | [as_led_blue==2]
 TRANS Blink -> On | [as_led_blue==1]
 TRANS On -> Close | [as_led_blue==0]
 TRANS Close -> Blink | [as_led_blue==2]
 TRANS Blink -> Close | [as_led_blue==0]

CHART=VCU10/LED_Control/Subsystem1/yellow
 STATE delay | delay en: yellow=uint16(60000);
 STATE node | node en: yellow=uint16(0);
 STATE Close | Close en: yellow=uint16(0);
 STATE On | On en: yellow=uint16(60000);
 STATE Blink | Blink en: yellow=uint16(30000);
 TRANS delay -> node | after(2,sec)
 TRANS node -> Blink | [as_led_yellow==2]
 TRANS node -> Close | [as_led_yellow==0]
 TRANS node -> On | [as_led_yellow==1]
 TRANS Close -> On | [as_led_yellow==1]
 TRANS On -> Blink | [as_led_yellow==2]
 TRANS Blink -> On | [as_led_yellow==1]
 TRANS On -> Close | [as_led_yellow==0]
 TRANS Close -> Blink | [as_led_yellow==2]
 TRANS Blink -> Close | [as_led_yellow==0]

CHART=VCU10/Motor_Control/ManualTorque_Calculation/Pedal_Fault_Check
 TRANS <junction> -> <junction> | [abs(apps1-apps2)>=0.1]{fault_count = fault_count + 1}
 TRANS <junction> -> <junction> | {fault_count=0;pedal_error=0}
 TRANS <junction> -> <junction> | [fault_count>=3]{pedal_error=1}

CHART=VCU10/ESP/ESP_ReceiveMsg/Subsystem/brkmotor_check_system
 STATE begin | begin 
 STATE compare | compare brkmotor_check=T;
 STATE same | same lscnt = lscnt + 1;
 STATE judge | judge brkmotor_check=F;
 TRANS begin -> compare | [hasChanged(lifesig)]
 TRANS judge -> compare | [hasChanged(lifesig)]{lscnt=0}
 TRANS same -> compare | [hasChanged(lifesig)]{lscnt=0}
 TRANS compare -> same | [~hasChanged(lifesig)]
 TRANS same -> judge | [lscnt>10]

CHART=VCU10/ESP/ESP_TransmitMsg/ESP_R_00/ESP_Chart1
 STATE ESC_Unable | ESC_Unable en: mode=0; %mode=机械模式;
 STATE ESC_Engage | ESC_Engage en: %开环模式; mode=1; tarPrsReqFL=ipc_esp_flprs; tarPrsReqFR=ipc_esp_frprs; tarPrsReqRL=ipc_esp_rlprs; tarPrsReqRR=ipc_esp_rrprs; du: mode=1; tarPrsReqFL=ipc_esp_flprs; tarPrsReqFR=ipc_esp_frprs; tarPrsReqRL=ipc_esp_rlprs; tarPrsReqRR=ipc_esp_rrprs;
 STATE ESC_Able | ESC_Able en: %开环模式; mode=1; tarPrsReqFL=ipc_esp_flprs; tarPrsReqFR=ipc_esp_frprs; tarPrsReqRL=ipc_esp_rlprs; tarPrsReqRR=ipc_esp_rrprs; du: mode=1; tarPrsReqFL=ipc_esp_flprs; tarPrsReqFR=ipc_esp_frprs; tarPrsReqRL=ipc_esp_rlprs; tarPrsReqRR=ipc_esp_rrprs;
 TRANS ESC_Able -> ESC_Unable | [brake_flag==0]
 TRANS ESC_Unable -> ESC_Engage | [brake_flag==2]
 TRANS ESC_Engage -> ESC_Able | [brake_flag==1]

CHART=VCU10/Res/Res_Msg/Subsystem/heaartbeat_chart
 STATE begin | begin 
 STATE compare | compare res_hbcheck=1;
 STATE same | same hbcnt = hbcnt + 1;
 STATE judge | judge res_hbcheck=0;
 TRANS begin -> compare | [hasChanged(res_heartbeat)]
 TRANS judge -> compare | [hasChanged(res_heartbeat)]{hbcnt=0}
 TRANS same -> compare | [hasChanged(res_heartbeat)]{hbcnt=0}
 TRANS compare -> same | [~hasChanged(res_heartbeat)]
 TRANS same -> judge | [hbcnt>30]

CHART=VCU10/Res/Res_Msg/Subsystem/xor_Check
 STATE compare | compare en: xorcheck=1;
 STATE Init | Init en: err_cnt=0; 
 STATE different | different en: err_cnt = err_cnt + 1;
 STATE judge | judge en: xorcheck=0;
 TRANS Init -> compare | [res_xorcheck==xor_consequence]
 TRANS judge -> compare | [res_xorcheck==xor_consequence]{err_cnt=0}
 TRANS compare -> different | [res_xorcheck~=xor_consequence]
 TRANS different -> compare | [res_xorcheck==xor_consequence]{err_cnt=0}
 TRANS different -> judge | [err_cnt>=10]

[MATLAB_FUNCTIONS]

--- VCU10/DBC_Debug_Select/DBC_Debug_Select ---
function [hin_sel, ain_sel, wheel_f_sel, wheel_h_sel, status_base, pedal_echo, air_wheel_echo] = dbg_select(hin_hw, ain_hw, wheel_f_hw, wheel_h_hw, control, pedal_adc, air_wheel, digital, rx_count)
%#codegen
% Bench-only CAN override. Any stale control/data frame restores hardware input.
persistent last_count ages initialized
if isempty(initialized)
    last_count = uint8(zeros(4,1));
    ages = repmat(uint8(50),4,1);
    initialized = true;
end
for i = 1:4
    if rx_count(i) ~= last_count(i)
        last_count(i) = rx_count(i);
        ages(i) = uint8(0);
    elseif ages(i) < uint8(50)
        ages(i) = ages(i) + uint8(1);
    end
end
requested = uint8(0);
if control(1) == uint8(165) && control(2) == uint8(90) && ages(1) < uint8(50)
    requested = bitand(control(3), uint8(15));
end
active = uint8(0);
if bitand(requested,uint8(1)) ~= uint8(0)
    active = bitor(active,uint8(1));
    if bitand(requested,uint8(2)) ~= uint8(0) && ages(2) < uint8(50)
        active = bitor(active,uint8(2));
    end
    if bitand(requested,uint8(4)) ~= uint8(0) && ages(3) < uint8(50)
        active = bitor(active,uint8(4));
    end
    if bitand(requested,uint8(8)) ~= uint8(0) && ages(4) < uint8(50)
        active = bitor(active,uint8(8));
    end
end
hin_sel = uint16(hin_hw);
ain_sel = uint16(ain_hw);
wheel_f_sel = single(wheel_f_hw);
wheel_h_sel = single(wheel_h_hw);
if bitand(active,uint8(8)) ~= uint8(0)
    hin_sel = uint16(digital(1)) + bitshift(uint16(digital(2)),8);
end
if bitand(active,uint8(2)) ~= uint8(0)
    ain_sel(1) = uint16(pedal_adc(1)) + bitshift(uint16(pedal_adc(2)),8);
    ain_sel(2) = uint16(pedal_adc(3)) + bitshift(uint16(pedal_adc(4)),8);
    ain_sel(3) = uint16(pedal_adc(5)) + bitshift(uint16(pedal_adc(6)),8);
end
if bitand(active,uint8(4)) ~= uint8(0)
    ain_sel(4) = uint16(air_wheel(1)) + bitshift(uint16(air_wheel(2)),8);
    ain_sel(5) = uint16(air_wheel(3)) + bitshift(uint16(air_wheel(4)),8);
    wheel_f_sel = single(uint16(air_wheel(5)) + bitshift(uint16(air_wheel(6)),8)) * single(0.1);
    wheel_h_sel = single(uint16(air_wheel(7)) + bitshift(uint16(air_wheel(8)),8)) * single(0.1);
end
status_base = uint8(zeros(8,1));
status_base(1) = active;
status_base(2) = requested;
status_base(3) = uint8(bitand(hin_sel,uint16(255)));
status_base(4) = uint8(bitshift(hin_sel,-8));
status_base(7) = ages(1);
status_base(8) = rx_count(1);
pedal_echo = uint8(zeros(8,1));
pedal_echo(1) = uint8(bitand(ain_sel(1),uint16(255)));
pedal_echo(2) = uint8(bitshift(ain_sel(1),-8));
pedal_echo(3) = uint8(bitand(ain_sel(2),uint16(255)));
pedal_echo(4) = uint8(bitshift(ain_sel(2),-8));
pedal_echo(5) = uint8(bitand(ain_sel(3),uint16(255)));
pedal_echo(6) = uint8(bitshift(ain_sel(3),-8));
if bitand(active,uint8(2)) ~= uint8(0)
    pedal_echo(7) = uint8(1);
end
pedal_echo(8) = rx_count(2);
air_wheel_echo = uint8(zeros(8,1));
air_wheel_echo(1) = uint8(bitand(ain_sel(4),uint16(255)));
air_wheel_echo(2) = uint8(bitshift(ain_sel(4),-8));
air_wheel_echo(3) = uint8(bitand(ain_sel(5),uint16(255)));
air_wheel_echo(4) = uint8(bitshift(ain_sel(5),-8));
wheel_raw = wheel_f_sel * single(10.0);
if wheel_raw <= single(0.0)
    wheel_u16 = uint16(0);
elseif wheel_raw >= single(65535.0)
    wheel_u16 = uint16(65535);
else
    wheel_u16 = uint16(floor(wheel_raw + single(0.5)));
end
air_wheel_echo(5) = uint8(bitand(wheel_u16,uint16(255)));
air_wheel_echo(6) = uint8(bitshift(wheel_u16,-8));
wheel_raw = wheel_h_sel * single(10.0);
if wheel_raw <= single(0.0)
    wheel_u16 = uint16(0);
elseif wheel_raw >= single(65535.0)
    wheel_u16 = uint16(65535);
else
    wheel_u16 = uint16(floor(wheel_raw + single(0.5)));
end
air_wheel_echo(7) = uint8(bitand(wheel_u16,uint16(255)));
air_wheel_echo(8) = uint8(bitshift(wheel_u16,-8));
end

