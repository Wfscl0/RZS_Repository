        <P Name="script">function ebs_sensor_fault = ebs_response_monitor(trigger, asms, driver_ok, air_ready_bar, air_work_bar)
%#codegen
% EBS_Driver handles electrical faults; VCU verifies pneumatic response.
persistent last_trigger waiting wait_count relation_count clear_count fault_latched
if isempty(last_trigger)
    last_trigger=false; waiting=false; wait_count=uint16(0); relation_count=uint16(0);
    clear_count=uint16(0); fault_latched=false;
end
rising = logical(trigger) &amp;&amp; ~last_trigger; last_trigger=logical(trigger);
if rising &amp;&amp; logical(driver_ok) &amp;&amp; (air_ready_bar &gt;= 2.5) &amp;&amp; (air_work_bar &lt; 1.0)
    waiting=true; wait_count=uint16(0);
end
if waiting
    if air_work_bar &gt;= 1.0
        waiting=false; wait_count=uint16(0);
    else
        if wait_count&lt;uint16(1000), wait_count=wait_count+uint16(1); end
        if wait_count&gt;=uint16(50), fault_latched=true; waiting=false; end
    end
end
if air_work_bar &gt; air_ready_bar + 1.5
    if relation_count&lt;uint16(1000), relation_count=relation_count+uint16(1); end
    if relation_count&gt;=uint16(20), fault_latched=true; end
else
    relation_count=uint16(0);
end
% Recovery is deliberately slow and only allowed outside autonomous mode.
if (~logical(asms)) &amp;&amp; logical(driver_ok) &amp;&amp; (air_work_bar &lt; 1.0) &amp;&amp; (air_ready_bar &gt;= 2.5)
    if clear_count&lt;uint16(1000), clear_count=clear_count+uint16(1); end
    if clear_count&gt;=uint16(100), fault_latched=false; end
else
    clear_count=uint16(0);
end
ebs_sensor_fault = fault_latched;
end
</P>
